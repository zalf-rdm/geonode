# #################
# Dev environment overrides
# Only values that differ from the root .env
# #################

# Enable debug for development
DEBUG=True
DEBUG_STATIC=True

# ZALF custom metadata template
CATALOG_METADATA_TEMPLATE=catalogue/zalf_metadata.xml
COMPOSE_PROJECT_NAME=geonode
DOCKER_ENV=development

# Advanced Workflow
RESOURCE_PUBLISHING=False
ADMIN_MODERATE_UPLOADS=False

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost

DEBUG=True
DEBUG_STATIC=True

CATALOG_METADATA_TEMPLATE="catalogue/zalf_metadata.xml"

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8081

# DataCite. Keep the test API here: the name was ZALF_DATACITE_BASE_UR (no "L")
# until 2026-11-10, which silently left the setting at its default of
# https://api.datacite.org/ -- i.e. a dev stack minting real DOIs.
ZALF_DATACITE_BASE_URL=https://api.test.datacite.org/
# One entry per DataCite repository, as JSON. "groups" are the Django groups
# whose members may use that account: members may approve, managers may publish.
# PUBLISH_DATA_COLLECTION_ALLOWED_GROUPS is derived from these and cannot be set
# on its own -- see the block in geonode/settings.py. An empty list here switches
# the publication workflow off for everyone but superusers.
ZALF_DATACITE_ACCOUNTS='[{"username": "TIB.BONARES", "password": "", "groups": ["bonares_data_stewards"]}]'
SOCIALACCOUNT_ONLY="True"
SOCIALACCOUNT_PROVIDER="ORCID"
SOCIALACCOUNT_PROVIDER_CONNECTOR_NAME="ORCID"
SOCIALACCOUNT_PROVIDER_REALM="ORCID"
SOCIALACCOUNT_PROVIDER_HOST=""
SOCIALACCOUNT_ORCID_BASE_URL="https://sandbox.orcid.org"
SOCIALACCOUNT_LOGOUT_REDIRECT_URL="https://sandbox.orcid.org/signout"
SOCIALACCOUNT_PROFILE_EXTRACTOR="geonode.people.profileextractors.OrcidExtractor"
SOCIALACCOUNT_GROUPNAME_PREFIX="gn_"
SOCIALACCOUNT_CLIENT_ID=""
SOCIALACCOUNT_CLIENT_SECRET=""